# --- Required ---------------------------------------------------------------

# Postgres connection string.
DATABASE_URL=postgres://statesman:statesman@localhost:5432/statesman

# 32 random bytes, base64-encoded. Generate with: pnpm gen:key
# LOSING THIS KEY MEANS LOSING ALL STATE. Back it up alongside — but never
# inside — your database backup.
STATESMAN_ENCRYPTION_KEY=

# Better Auth signing secret, at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Drivers ----------------------------------------------------------------

# neon = @neondatabase/serverless (Vercel), node = pg Pool (long-lived process)
DB_DRIVER=node

# s3 = any S3-compatible endpoint, local = node:fs (never on serverless)
STORAGE_DRIVER=local

# --- Local storage driver ---------------------------------------------------

LOCAL_STORAGE_PATH=./.data/state

# --- S3 storage driver ------------------------------------------------------

# S3_BUCKET=statesman
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# --- Seeding ----------------------------------------------------------------

# Slug of the single organization `pnpm db:seed` creates on a fresh database.
# It becomes the :org segment of every backend address, e.g. /api/tf/acme/prod.
# STATESMAN_ORG_SLUG=acme

# Comma-separated projects `pnpm db:seed` creates. Defaults to `prod`. Projects
# are normally made in the dashboard; this is the non-interactive route.
# STATESMAN_SEED_PROJECTS=prod,staging

# `pnpm user:create` reads these when they are not passed as arguments. There is
# no public sign-up: accounts exist only because an operator made one.
# STATESMAN_USER_EMAIL=you@example.com
# STATESMAN_USER_PASSWORD=
# STATESMAN_USER_NAME="Your Name"

# --- Tests ------------------------------------------------------------------

# `pnpm test` never runs against DATABASE_URL. It creates and migrates a
# separate database — by default the one above with `_test` appended — because
# the suites truncate what they touch, and a shared database meant a test run
# left fake projects, sign-in-able accounts and live tokens in your dashboard.
# Set this only to point CI at a database it provisioned. It may not equal
# DATABASE_URL; the suites refuse to start if it does.
# TEST_DATABASE_URL=postgres://statesman:statesman@localhost:5432/statesman_test

# --- Retention --------------------------------------------------------------

# Lets a scheduler run retention on a deployment that has no scheduler of its
# own. Nitro's scheduled task needs a process that stays alive, so on Vercel
# (or any serverless host) nothing prunes old versions unless something calls
# in. With this set, `GET /api/admin/retention` accepts
# `Authorization: Bearer $CRON_SECRET`; with it unset that route is a 404, so
# an unset secret can never become an open endpoint.
#
# On Vercel, set it in the project's environment variables and the platform
# sends it with every cron request; vercel.json already schedules 03:17 daily.
# Not needed for Docker, where the in-process task already runs at 03:17.
# CRON_SECRET=

# Keep the last N versions and everything newer than M days, whichever is more.
RETENTION_KEEP_VERSIONS=100
RETENTION_KEEP_DAYS=30
