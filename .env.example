# --- Required ---------------------------------------------------------------

# Postgres connection string.
DATABASE_URL=postgres://statesman:statesman@localhost:5432/statesman

# 32 random bytes, base64-encoded. Generate with: pnpm gen:key
# LOSING THIS KEY MEANS LOSING ALL STATE. Back it up alongside — but never
# inside — your database backup.
STATESMAN_ENCRYPTION_KEY=

# Better Auth signing secret, at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Drivers ----------------------------------------------------------------

# neon = @neondatabase/serverless (Vercel), node = pg Pool (long-lived process)
DB_DRIVER=node

# s3 = any S3-compatible endpoint, local = node:fs (never on serverless)
STORAGE_DRIVER=local

# --- Local storage driver ---------------------------------------------------

LOCAL_STORAGE_PATH=./.data/state

# --- S3 storage driver ------------------------------------------------------

# S3_BUCKET=statesman
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# --- Retention --------------------------------------------------------------

# Keep the last N versions and everything newer than M days, whichever is more.
RETENTION_KEEP_VERSIONS=100
RETENTION_KEEP_DAYS=30
