# Copy to .env.prod, fill in the four blanks, and run:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# Everything here is interpolated by docker compose, not read by the app: the
# app's own environment is assembled in docker-compose.prod.yml.

# --- Required. The deployment refuses to start without these ------------------

# The public origin, exactly as browsers and the terraform CLI will reach it.
# Use http://localhost:3000 to try it out on one machine.
BETTER_AUTH_URL=https://statesman.example.com

# Generate with: openssl rand -base64 32
#
# LOSING THIS KEY MEANS LOSING ALL STATE AND VARIABLES. It is not recoverable
# from the database, and it must be backed up somewhere the database backup is
# not — a backup that contains both is a single artefact that decrypts itself.
STATESMAN_ENCRYPTION_KEY=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Password for the bundled postgres service, and for the DATABASE_URL derived
# from it. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Organization -------------------------------------------------------------

# The :org segment of every backend address, e.g. /api/tf/acme/prod. Pick it
# before seeding: it is part of every Terraform backend block you hand out.
# STATESMAN_ORG_SLUG=acme

# Projects `pnpm db:seed` creates. More can be made in the dashboard later.
# STATESMAN_SEED_PROJECTS=prod

# --- Optional ----------------------------------------------------------------

# Host port to publish the app on.
# PORT=3000

# Point at a managed database instead of the bundled one. When set, the
# postgres service can be deleted from the compose file.
# DATABASE_URL=postgres://user:pass@db.example.com:5432/statesman
# POSTGRES_USER=statesman
# POSTGRES_DB=statesman

# local keeps state on the `statedata` volume; s3 uses the settings below.
# STORAGE_DRIVER=local
# S3_BUCKET=statesman
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=false
# Omit both keys to use the AWS default credential chain.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Retention keeps the last N versions and everything newer than M days,
# whichever is more. It runs inside the app at 03:17 daily.
# RETENTION_KEEP_VERSIONS=100
# RETENTION_KEEP_DAYS=30

# --- GitHub App (optional) ----------------------------------------------------

# Lets the Variables tab discover the variables a repository declares. Set all
# four or none; see docs/github-app.md. Write the private key on one line, with
# \n for each line break.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# GITHUB_APP_WEBHOOK_SECRET=
