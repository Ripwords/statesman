# Copy to .env.prod, fill in, and run:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# Everything here is interpolated by docker compose, not read by the app: the
# app's own environment is assembled in docker-compose.prod.yml.

# --- Required. The deployment refuses to start without these ------------------

# Password for the bundled postgres service, and for the DATABASE_URL derived
# from it. Any value; generate one with: openssl rand -base64 24
POSTGRES_PASSWORD=

# 32 random bytes, base64-encoded. Generate with: pnpm gen:key
#
# LOSING THIS KEY MEANS LOSING ALL STATE. It is not recoverable from the
# database, and it must be backed up somewhere the database backup is not — a
# backup that contains both is a single artefact that decrypts itself.
STATESMAN_ENCRYPTION_KEY=

# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public origin, exactly as browsers and the terraform CLI will reach it.
BETTER_AUTH_URL=https://statesman.example.com

# --- Optional ----------------------------------------------------------------

# POSTGRES_USER=statesman
# POSTGRES_DB=statesman

# Point at a managed database instead of the bundled one. When set, the
# postgres service can be deleted from the compose file.
# DATABASE_URL=postgres://user:pass@db.example.com:5432/statesman

# Host port to publish the app on.
# PORT=3000

# local keeps state on the `statedata` volume; s3 uses the settings below.
# STORAGE_DRIVER=local
# S3_BUCKET=statesman
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Only needed if something outside this deployment triggers retention. The
# bundled compose file runs a long-lived server, whose in-process task already
# runs at 03:17 daily, so leave it unset there.
# CRON_SECRET=

# RETENTION_KEEP_VERSIONS=100
# RETENTION_KEEP_DAYS=30
