{
  "name": "statesman",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hostable Terraform HTTP state backend with encrypted state at rest",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "oxlint --max-warnings=0",
    "lint:fix": "oxlint --fix --max-warnings=0",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e",
    "typecheck": "vue-tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "user:create": "tsx scripts/user-create.ts",
    "gen:key": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64'))\"",
    "prepare": "husky",
    "dev:setup": "docker compose up -d --wait postgres minio && docker compose run --rm createbucket && pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@better-auth/api-key": "1.7.2",
    "@better-auth/utils": "0.4.2",
    "@neondatabase/serverless": "1.1.0",
    "@nuxt/ui": "4.11.0",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "nuxt": "4.5.2",
    "pg": "8.23.0",
    "ulid": "^3.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.2.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.62.1",
    "tsx": "4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.25.0"
}
