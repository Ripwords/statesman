{
  "name": "statesman",
  "version": "0.1.0",
  "description": "Self-hostable Terraform HTTP state backend with encrypted state at rest",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "gen:key": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64'))\""
  },
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@neondatabase/serverless": "1.1.0",
    "@nuxt/ui": "4.11.0",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "nuxt": "4.5.2",
    "pg": "8.23.0",
    "ulid": "^3.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "private": true,
  "type": "module"
}
