{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    ".nuxt/nuxt.d.ts",
    ".nuxt/nuxt.node.d.ts",
    ".nuxt/nuxt.shared.d.ts",
    ".nuxt/types/nitro.d.ts",
    ".nuxt/types/nitro-nuxt.d.ts",
    "app/**/*",
    "server/**/*",
    "shared/**/*",
    "tests/**/*",
    "scripts/**/*",
    "*.ts"
  ],
  "exclude": ["node_modules", ".output", ".nuxt/dist", "dist", ".data"]
}
